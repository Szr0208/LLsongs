            icon: "⭐",
            title: "群星集結",
            subtitle: "Liella! 團曲"
        }
    ]
};
/* =========================================================
   狀態
========================================================= */
let selectedMood = null;
let selectedGroup = null;
let currentSong = null;
/* =========================================================
   切換主題
========================================================= */
function setTheme(mood) {
    const theme = themes[mood];
    document.documentElement
        .style
        .setProperty(
            "--main",
            theme.main
        );
    document.documentElement
        .style
        .setProperty(
            "--main-light",
            theme.light
        );
    document.documentElement
        .style
        .setProperty(
            "--main-dark",
            theme.dark
        );
}
/* =========================================================
   選擇心情
========================================================= */
function selectMood(mood) {
    selectedMood = mood;
    setTheme(mood);
    renderGroupChoices(mood);
    showScreen(2);
}
/* =========================================================
   產生第二題
========================================================= */
function renderGroupChoices(mood) {
    const container =
        document.getElementById(
            "groupChoices"
        );
    const description =
        document.getElementById(
            "groupDescription"
        );
    container.innerHTML = "";
    if (mood === "muse") {
        description.textContent =
            "如果今天是一片櫻花，你想看見哪一種風景？";
    }
    else if (mood === "aqours") {
        description.textContent =
            "如果今天是一片海，你想遇見哪一種浪？";
    }
    else {
        description.textContent =
            "如果今天抬頭看見星空，你想看見哪一片星光？";
    }
    groupOptions[mood]
        .forEach(option => {
            const button =
                document.createElement(
                    "button"
                );
            button.className =
                "choice";
            button.innerHTML = `
                <div class="choice-icon">
                    ${option.icon}
                </div>
                <div>
                    <div class="choice-title">
                        ${option.title}
                    </div>
                    <div class="choice-subtitle">
                        ${option.subtitle}
                    </div>
                </div>
            `;
            button.onclick = function() {
                selectGroup(
                    option.key
                );
            };
            container.appendChild(
                button
            );
        });
}
/* =========================================================
   選擇小分隊
========================================================= */
function selectGroup(group) {
    selectedGroup = group;
    showResult();
}
/* =========================================================
   隨機
========================================================= */
function randomSong(songs) {
    const index =
        Math.floor(
            Math.random() *
            songs.length
        );
    return songs[index];
}
/* =========================================================
   顯示結果
========================================================= */
function showResult() {
    const category =
        songData
        [selectedMood]
        [selectedGroup];
    if (
        !category ||
        !category.songs ||
        category.songs.length === 0
    ) {
        alert(
            "這個分類目前還沒有歌曲資料。"
        );
        return;
    }
    currentSong =
        randomSong(
            category.songs
        );
    document
        .getElementById("songName")
        .textContent =
        currentSong.name;
    document
        .getElementById("groupName")
        .textContent =
        currentSong.group;
    document
        .getElementById("albumCover")
        .src =
        currentSong.cover;
    document
        .getElementById("albumCover")
        .alt =
        currentSong.name;
    document
        .getElementById("resultCategory")
        .textContent =
        category.title;
    showScreen(3);
}
/* =========================================================
   再抽一首
========================================================= */
function drawAgain() {
    if (!selectedMood || !selectedGroup) {
        return;
    }
    showResult();
}
/* =========================================================
   重新開始
========================================================= */
function restart() {
    selectedMood = null;
    selectedGroup = null;
    currentSong = null;
    setTheme("muse");
    showScreen(1);
}
/* =========================================================
   跳轉聽歌
========================================================= */
function listenSong() {
    if (
        !currentSong ||
        !currentSong.url
    ) {
        return;
    }
    window.open(
        currentSong.url,
        "_blank"
    );
}
/* =========================================================
   Screen 切換
========================================================= */
function showScreen(number) {
    document
        .querySelectorAll(".screen")
        .forEach(
            screen => {
                screen.classList
                    .remove("active");
            }
        );
    document
        .getElementById(
            "screen" + number
        )
        .classList
        .add("active");
    document
        .querySelectorAll(".progress-dot")
        .forEach(
            dot => {
                dot.classList
                    .remove("active");
            }
        );
    for (
        let i = 1;
        i <= number;
        i++
    ) {
        document
            .getElementById(
                "dot" + i
            )
            .classList
            .add("active");
    }
    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}
</script>
</body>
</html>
